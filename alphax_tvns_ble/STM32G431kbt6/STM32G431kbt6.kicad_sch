	(label "BLE_SWDCLK"
		(at 289.56 327.66 270)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "4687f6eb-26ac-4bfe-abd2-be1437ec68ab")
	)
	(text "U8 switches BLE_VCC: PA7 high = module on. R30 keeps it off while PA7 floats (reset/Standby)."
		(exclude_from_sim no)
		(at 200.66 345.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "362e84df-d3d3-4dce-84c0-4c1ca229a0c6")
	)
	(text "C32 (CT to VIN) slows turn-on to ~1.5 ms so the ~5 uF charge-up draws <10 mA and doesn't dip +3V0."
		(exclude_from_sim no)
		(at 200.66 349.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5e520548-7308-4ce1-831e-f556dad2dfef")
	)
	(text "R31 (0R) ties QOD to VOUT: BLE_VCC discharges through 150R internal, so U7 resets cleanly when off."
		(exclude_from_sim no)
		(at 200.66 353.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a4d91173-7abf-4ed8-9e93-1c6bf37aae99")
	)
	(text "Before switching off, drive PA9/PB0/PB4 low (or analog) so they don't back-power U7 through its I/O."
		(exclude_from_sim no)
		(at 200.66 356.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d95c62c6-9519-498d-9d14-2faa684dc2b2")
	)
	(text "U7: ANNA-B112-02B ships with u-connectXpress; the STM32 drives it with AT commands on USART1"
		(exclude_from_sim no)
		(at 200.66 360.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "926d87f3-bf57-4109-93a1-ffeaef99da5f")
	)
	(text "(PA9 TX -> BLE_RXD, PA10 RX <- BLE_TXD), 115200 8N1. BLE_VCC = switched +3V0, so UART levels match."
		(exclude_from_sim no)
		(at 200.66 364.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "89697d37-344c-44bd-8ac3-02250d501daa")
	)
	(text "2-wire UART (SIM 1.8.1): module CTS to GND; RTS only to TP6. USART1 CTS/RTS (PA11/PA12) carry USB."
		(exclude_from_sim no)
		(at 200.66 368.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "37b5c8a2-8473-446f-be07-d1ffae2b75f4")
	)
	(text "PB0 -> DSR (command mode / wake), PB6 <- DTR (status), PB4 -> RESET_N (module has its own pull-up)."
		(exclude_from_sim no)
		(at 200.66 372.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "edb64a7f-8013-4725-808c-9c3a0b80c687")
	)
	(text "PB4/PB6 are UCPD CC pins: keep HAL_PWREx_DisableUCPDDeadBattery() in startup (CubeMX adds it)."
		(exclude_from_sim no)
		(at 200.66 375.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "27edfc70-bcc5-41c6-9f42-b3e5ceae60c9")
	)
	(text "Internal antenna: pin 5 (ANT_INT) to pin 6 (ANT). Module goes in a PCB corner (SIM Table 12):"
		(exclude_from_sim no)
		(at 200.66 379.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f18a7506-fc5b-4c1d-af04-3316f02d5864")
	)
	(text "pin 1 reaches GND through the App. B.1 antenna strip (NT1 keeps it a separate trace); pins 2/3 NC."
		(exclude_from_sim no)
		(at 200.66 383.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "01f10f88-c013-4ddf-b511-1ad5581c5b9c")
	)
	(text "Copy SIM App. B.1 Fig. 27/28 exactly (no GND/parts in the antenna area) to keep the modular approval."
		(exclude_from_sim no)
		(at 200.66 387.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6cbc8fb5-c26d-486f-8d90-147214ded925")
	)
	(text "Y1: Epson FC-135 32.768 kHz, CL 7 pF, ESR 70k. C28/C29 = 2 x CL - Cpin 4 pF - Cpcb ~1 pF = 9 pF C0G."
		(exclude_from_sim no)
		(at 200.66 391.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "17aa6cf6-b4a5-4ad1-a7f7-7441ddf8e866")
	)
	(text "TP1-TP5: s-center reflash needs UART, RESET_N, SWITCH_1/2 (hold both during reset = bootloader)."
		(exclude_from_sim no)
		(at 200.66 394.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f0fbe3e1-aeb5-4226-b225-d98dc1dc269c")
	)
