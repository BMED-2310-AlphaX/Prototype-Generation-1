	(text "Iout = (V_PA4 - V_PA5) x (1/R15 + 1/R11) = 10.0 mA per volt. Cblock -> ELEC_BLK -> U9 output switch (block 13)."
		(exclude_from_sim no)
		(at 266.7 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "45edc4a6-10dc-413e-8d05-e5289572638b")
	)
	(text "R11-R14 matched (0.05% Susumu RG). Ideal R12 is 150.1k (R11 + R15); 150k leaves the bridge slightly low, the safe side."
		(exclude_from_sim no)
		(at 266.7 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8f110f65-c761-44ad-a53c-b022b92dff48")
	)
	(text "Servo: R17/C13 integrate DRV (tau 1 s), R19 feeds the correction into HOW_INP, R20 keeps the bridge balanced."
		(exclude_from_sim no)
		(at 266.7 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "784eb66d-4dbb-417f-bd2c-5967b0693566")
	)
	(text "U6 = OPA2196 (rail-to-rail I/O, no phase reversal): the servo needs no input clamps. C14/C15 sit at U6 pins 8 and 4."
		(exclude_from_sim no)
		(at 266.7 168.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d8fcd4a5-638b-4136-a8ef-4a12dd868793")
	)
	(text "LTspice names: R11=R1 R12=R2 R13=R3 R14=R4 R15=Rs R16=Rbleed C12=Cblock R17=Ri C13=Ci R18=Rp R19=Rinj R20=Rinj2"
		(exclude_from_sim no)
		(at 266.7 172.72 0)
		(effects
